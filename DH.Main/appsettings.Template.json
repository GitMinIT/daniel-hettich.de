{
  "AllowedHosts": "daniel-hettich.de",
  "ConnectionStrings": {
    //"MainConnection": "Server=
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
          "fileSizeLimitBytes": 10485760 // 10 MiB
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          //"connectionString": "Server=deinServerName;Database=deineDatenbank;Integrated Security=SSPI;",
          "tableName": "Logs",
          "autoCreateSqlTable": true
        }
      }
    ]
  },
  "Seed": {
    "Users": [
      {
        "UserName": "Admin",
        "Email": "<mailadress>",
        "Password": "<password>"
      }
    ]
  },
  "Jwt": {
    "Issuer": "https://www.daniel-hettich.de",
    "Audience": "https://www.daniel-hettich.de",
    "Key": "<validrandomstring>"
  }
}
