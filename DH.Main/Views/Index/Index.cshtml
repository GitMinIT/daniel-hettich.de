            adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
        </p>
    </div>

    <!-- Skills Section -->
    <div class="w3-padding-64 w3-content" id="skills">
        <h2 class="w3-text-light-grey">Skills</h2>
        <hr style="width:200px" class="w3-opacity">

        <div class="w3-row">
            <div class="w3-half">
                <h3>Sprachen</h3>
                <p>C#</p>
                <p>Python</p>
                <p>JavaScript</p>
            </div>
            <div class="w3-half">
                <h3>Frameworks</h3>
                <p>ASP.Net Core</p>
                <p>jQuery</p>
            </div>
        </div>
    </div>

    <!-- Contact Section -->
    <div class="w3-padding-64 w3-content w3-text-grey" id="contact">
        <h2 class="w3-text-light-grey">Kontakt</h2>
        <hr style="width:200px" class="w3-opacity">
        <form action="" target="_self">
            <p><input class="w3-input w3-padding-16" type="text" placeholder="Name" required name="Name" disabled></p>
            <p><input class="w3-input w3-padding-16" type="text" placeholder="Email" required name="Email" disabled></p>
            <p><input class="w3-input w3-padding-16" type="text" placeholder="Betreff" required name="Subject" disabled></p>
            <p><input class="w3-input w3-padding-16" type="text" placeholder="Nachricht" required name="Message" disabled></p>
            <p>
                <button class="w3-button w3-light-grey w3-padding-large" type="submit" onclick="notAvailableYet()">
                    <i class="fa fa-paper-plane"></i> Senden
                </button>
            </p>
        </form>
        <div id="notAvailableYetText"></div>
    </div>
</div>
<script>
    function notAvailableYet() {
        var notAvailableText = document.getElementById("notAvailableYetText");
        notAvailableText.innerHTML = "Derzeit nicht verfügbar";
        notAvailableText.style.color = "red";
        setTimeout(function () {
            notAvailableText.innerHTML = "";
        }, 5000);
    }
</script>

